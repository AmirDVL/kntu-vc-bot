[Unit]
Description=KNTU VC Telegram homework bot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=kntu-vc-bot
Group=kntu-vc-bot
WorkingDirectory=/opt/kntu-vc-bot/current
EnvironmentFile=/etc/kntu-vc-bot.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/kntu-vc-bot/venv/bin/python -u /opt/kntu-vc-bot/current/bot.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=300
KillSignal=SIGTERM
StateDirectory=kntu-vc-bot
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kntu-vc-bot
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
